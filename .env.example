# Copy to .env.local and fill in. Never commit real values.

# Public — inlined into the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only — bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Sending invoices ---------------------------------------------------
# Email goes out over SMTP.
#   Local: the Mailpit inbox from `pnpm db:start` (open http://127.0.0.1:54324)
#          SMTP_HOST=127.0.0.1 SMTP_PORT=54325 SMTP_SECURE=false, no user/password.
#   Resend: SMTP_HOST=smtp.resend.com SMTP_PORT=465 SMTP_SECURE=true
#           SMTP_USER=resend SMTP_PASSWORD=<your Resend API key>
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# Address invoices are sent from (must be on a domain verified with your provider).
# The sender name is each business's own name; replies go to its email.
EMAIL_FROM_ADDRESS=

# WhatsApp Business Cloud API (Meta). Leave empty to use "open WhatsApp" links instead.
# Needs an approved template — see docs/whatsapp-template.md.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=invoice_document
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_API_VERSION=v23.0
